# WhatsApp Microservice Port
PORT=5001

# Shared secret key between your main BuySell backend and this microservice
WHATSAPP_SERVICE_SECRET=buysell_super_secret_whatsapp_key_2026

# MongoDB connection string for persistent session (Recommended for Render free tier so login survives restarts!)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/buysell_whatsapp?retryWrites=true&w=majority

# Fallback directory if MONGO_URI is not provided
SESSION_DATA_PATH=./.baileys_auth
